```env
# =============================================================================
# NEXUS COMMERCE - ENVIRONMENT VARIABLES
# Copy this file to `.env` (root) and/or `server/.env` and fill in real values.
# NEVER commit real secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public URL of the API
API_URL=http://localhost:5000

# Public URL of the React client
CLIENT_URL=http://localhost:3000

# Comma separated list of extra allowed origins for CORS (optional)
CORS_EXTRA_ORIGINS=

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nexus_commerce

# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus_commerce?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Use a long random string.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Short-lived token used only for password reset
JWT_RESET_SECRET=change-me-too-another-long-random-string
JWT_RESET_EXPIRES_IN=15m

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------
# Payment provider:
# mock = built-in sandbox
# stripe = Stripe
PAYMENT_PROVIDER=mock

# -----------------------------------------------------------------------------
# MOCK / SANDBOX PAYMENT PROVIDER
# -----------------------------------------------------------------------------
# Local development values only.
# Change these values for production.
PAYMENT_SECRET_KEY=local_development_payment_secret
PAYMENT_WEBHOOK_SECRET=local_development_webhook_secret

# -----------------------------------------------------------------------------
# STRIPE
# -----------------------------------------------------------------------------
# Add Stripe credentials ONLY to your local .env file.
# Never commit Stripe credentials to GitHub.
#
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# If your application uses these aliases:
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# BUSINESS RULES
# -----------------------------------------------------------------------------
SHIPPING_FLAT_RATE=99
FREE_SHIPPING_THRESHOLD=1999
TAX_RATE=0.18
CURRENCY=INR
LOW_STOCK_THRESHOLD=10

# -----------------------------------------------------------------------------
# SEED DATA
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@nexus.dev
SEED_ADMIN_PASSWORD=Admin@12345

SEED_CUSTOMER_EMAIL=customer@nexus.dev
SEED_CUSTOMER_PASSWORD=Customer@123
```
