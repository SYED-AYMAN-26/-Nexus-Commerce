{
  "name": "nexus-commerce-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB REST API for Nexus Commerce",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ignore public/uploads --ext js,json server.js",
    "seed": "node seed/seed.js",
    "seed:destroy": "node seed/seed.js --destroy",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nexus-commerce": "file:..",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "optionalDependencies": {
    "stripe": "^17.5.0"
  }
}
