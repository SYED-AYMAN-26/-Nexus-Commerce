# -----------------------------------------------------------------------------
# CLIENT ENVIRONMENT
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here - anything in this file is public.
# -----------------------------------------------------------------------------

# Base URL of the REST API.
#  - Leave as `/api` to use the Vite dev proxy (recommended for local + previews).
#  - Point at a deployed API for production builds, e.g. https://api.myshop.com/api
VITE_API_URL=/api

# Store name shown in the UI
VITE_STORE_NAME=Nexus Commerce

# Support email used in the footer and help pages
VITE_SUPPORT_EMAIL=support@nexuscommerce.dev
